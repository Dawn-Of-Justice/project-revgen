# Copy to backend/.env for local development. Never commit the real file.
# In production these are set with `fly secrets set KEY=value` instead.

SARVAM_API_KEY=sk_xxx

# --- MQTT ---
# Local Mosquitto for development.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=

# Hosted broker (HiveMQ Cloud free tier) once the backend is not on the same
# LAN as the emitter:
# MQTT_HOST=xxxxx.s1.eu.hivemq.cloud
# MQTT_PORT=8883
# MQTT_TLS=true

# --- Access ---
# Shared secret the remote sends as the X-RevGen-Token header. Leave empty on a
# LAN; set it before the backend has a public URL, or anyone who finds the URL
# can control her television.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_TOKEN=

# --- Safety ---
# POWER_DEBOUNCE_S is the one that matters: how long a repeated "TV on" is
# ignored for, so an impatient second attempt cannot undo the first.
POWER_DEBOUNCE_S=8.0
MAX_VOLUME_STEPS=5

# --- Storage ---
# Where the TTS cache and utterance log live. /data on Fly (mounted volume).
# DATA_DIR=/data

# Set true to run the whole chain with no API key, no broker and no hardware.
OFFLINE=false
